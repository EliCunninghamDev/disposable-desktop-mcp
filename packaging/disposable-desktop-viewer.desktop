[Desktop Entry]
Type=Application
Version=1.0
Name=Disposable Desktop Viewer
GenericName=Private Desktop Viewer
Comment=Watch private X11 or Wayland desktops started by disposable-desktop-mcp
Exec=disposable-desktop-viewer
TryExec=disposable-desktop-viewer
Icon=video-display
Terminal=false
Categories=Development;
Keywords=desktop;viewer;mcp;virtual;display;screenshot;x11;wayland;
StartupNotify=true
StartupWMClass=disposable-desktop-viewer
Actions=bsp;

[Desktop Action bsp]
Name=Open in BSP tiling mode
Exec=disposable-desktop-viewer --layout bsp
